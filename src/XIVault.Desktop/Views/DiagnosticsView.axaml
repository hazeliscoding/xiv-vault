<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XIVault.Desktop.Controls"
             xmlns:vm="using:XIVault.Desktop.ViewModels"
             xmlns:v="using:XIVault.Desktop.Views"
             x:Class="XIVault.Desktop.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MaxWidth="880" />
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4" VerticalAlignment="Bottom">
          <TextBlock Classes="page-title" Text="Diagnostics" />
          <TextBlock Classes="body t2" Text="{Binding Subtitle}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <c:XvButton Classes="secondary" Icon="{Binding CopyIcon}" Content="{Binding CopyLabel}" HorizontalAlignment="Right"
                      Command="{Binding CopyReportCommand}" />
          <TextBlock Classes="compact t3" FontSize="11" HorizontalAlignment="Right"
                     Text="Paths, versions and results only. Plugin configuration contents are never included." />
        </StackPanel>
      </Grid>

      <c:Banner Tone="{Binding BannerTone}" Title="{Binding BannerTitle}" Description="{Binding BannerDescription}" IsVisible="{Binding HasBanner}">
        <c:Banner.Actions>
          <c:XvButton Classes="ghost sm" Content="{Binding BannerAction}" Command="{Binding BannerGoCommand}" />
        </c:Banner.Actions>
      </c:Banner>

      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DiagnosticGroupViewModel">
            <Border Classes="card enter" ClipToBounds="True" VerticalAlignment="Stretch">
              <StackPanel>
                <Border Height="38" Padding="14,0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <c:Icon Kind="{Binding Icon}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="card-title" Text="{Binding Title}" VerticalAlignment="Center" />
                    <c:StatusBadge Grid.Column="2" Classes="sm" Tone="{Binding Tone}" Label="{Binding StatusLabel}" />
                  </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiagnosticRow">
                      <Border MinHeight="34" Padding="14,6" BorderBrush="{StaticResource Border1}"
                              BorderThickness="{Binding HasDivider, Converter={x:Static v:Converters.TopHairline}}">
                        <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="10">
                          <c:Icon Kind="{Binding Icon}" Size="13" VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Foreground="{Binding Tone, Converter={x:Static c:ToneConverters.Main}}" />
                          <TextBlock Grid.Column="1" Classes="body" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="data t3" FontSize="11" Text="{Binding Detail}" TextAlignment="Right"
                                     TextWrapping="Wrap" MaxWidth="220" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>
