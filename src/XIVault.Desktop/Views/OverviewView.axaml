<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XIVault.Desktop.Controls"
             xmlns:vm="using:XIVault.Desktop.ViewModels"
             xmlns:v="using:XIVault.Desktop.Views"
             x:Class="XIVault.Desktop.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MaxWidth="880" />
    </Grid.ColumnDefinitions>
  <StackPanel Spacing="16">
    <StackPanel Spacing="4">
      <TextBlock Classes="page-title" Text="XIVault" />
      <TextBlock Classes="body t2" Text="{Binding Subtitle}" />
    </StackPanel>

    <c:Banner Tone="Critical" Title="The backup could not be completed" Description="{Binding ErrorMessage}"
              IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <c:Banner.Actions>
        <c:XvButton Classes="ghost sm" Content="Dismiss" Command="{Binding DismissErrorCommand}" />
      </c:Banner.Actions>
    </c:Banner>

    <!-- Health card: protected, just backed up, needs attention -->
    <Border Classes="card" Classes.complete-pulse="{Binding State, Converter={x:Static v:Converters.IsJustBackedUp}}"
            Padding="20,18" BoxShadow="{StaticResource HighlightInset}" IsVisible="{Binding ShowStats}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="14">
          <c:StatusBadge Classes="sm upper" Tone="{Binding BadgeTone}" Label="{Binding BadgeLabel, Converter={x:Static v:Converters.Upper}}" />
          <StackPanel Spacing="2">
            <TextBlock Classes="micro t3" Text="LAST BACKUP" />
            <TextBlock Classes="metric" Text="{Binding LastBackupLabel}" />
          </StackPanel>
          <WrapPanel ItemSpacing="24" LineSpacing="12">
            <StackPanel Spacing="3">
              <TextBlock Classes="data-value" FontSize="14" Text="{Binding PluginCount}" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="compact t3" Text="plugin configurations" VerticalAlignment="Center" />
                <Button Theme="{StaticResource ExplainButton}" AutomationProperties.Name="Explain plugin configurations"
                        AutomationProperties.HelpText="{x:Static vm:OverviewViewModel.PluginConfigsExplanation}" Click="OnExplainClick">
                  <ToolTip.Tip>
                    <StackPanel Spacing="3" MaxWidth="240">
                      <TextBlock Classes="micro t3" Text="PLUGIN CONFIGURATIONS" />
                      <TextBlock Classes="compact" TextWrapping="Wrap" Text="{x:Static vm:OverviewViewModel.PluginConfigsExplanation}" />
                    </StackPanel>
                  </ToolTip.Tip>
                </Button>
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="data-value" FontSize="14" Text="{Binding CompressedSize}" />
              <TextBlock Classes="compact t3" Text="compressed size" />
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="data-value" FontSize="14" Text="{Binding IntegrityLabel}"
                         Foreground="{Binding IntegrityTone, Converter={x:Static c:ToneConverters.Text}}" />
              <TextBlock Classes="compact t3" Text="backup integrity" />
            </StackPanel>
            <StackPanel Spacing="3" MaxWidth="300">
              <TextBlock Classes="data-value" FontSize="14" Text="{Binding Destination}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Destination}" />
              <TextBlock Classes="compact t3" Text="destination" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" Margin="24,0,0,0">
          <Border Classes="glow" HorizontalAlignment="Center">
            <c:XvButton Classes="primary lg" Icon="ArchiveRestore" Content="Back Up Now" Command="{Binding BackUpNowCommand}" />
          </Border>
          <c:XvButton Classes="secondary lg" Icon="RotateCcw" Content="Restore Backup" HorizontalAlignment="Center"
                      Command="{Binding RestoreCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Health card: backing up -->
    <Border Classes="card" Padding="20,18" BorderBrush="{StaticResource AccentBorder}" BoxShadow="{StaticResource AccentGlow}"
            IsVisible="{Binding ShowRunning}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <c:AetherRing Size="56" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="8" Margin="22,0" VerticalAlignment="Center">
          <TextBlock Classes="micro accent" Text="BACKING UP" />
          <TextBlock Classes="section-title" Text="{Binding StageLabel}" />
          <ProgressBar Classes="thin" Value="{Binding Percent}" Maximum="100" />
          <TextBlock Classes="data t3" Text="{Binding PercentLabel}" />
        </StackPanel>
        <c:XvButton Grid.Column="2" Classes="primary lg" Content="Back Up Now" IsLoading="True" IsEnabled="False" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Health card: no backups yet -->
    <Panel IsVisible="{Binding ShowEmpty}">
    <Rectangle Classes="dashed-card" />
    <Border Padding="20,22">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="section-title" Text="No backups yet" />
          <TextBlock Classes="body t2" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left" Text="{Binding EmptyDescription}" />
        </StackPanel>
        <Border Grid.Column="1" Classes="glow" VerticalAlignment="Center" Margin="24,0,0,0">
          <c:XvButton Classes="primary lg" Icon="ArchiveRestore" Content="Back Up Now" Command="{Binding BackUpNowCommand}" />
        </Border>
      </Grid>
    </Border>
    </Panel>

    <!-- Health card: fresh PC, XIVLauncher installed but nothing to back up yet -->
    <Border Classes="card" Padding="20,22" BorderBrush="{StaticResource Border2}" IsVisible="{Binding ShowNoConfiguration}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="section-title" Text="Setting up a new PC?" />
          <TextBlock Classes="body t2" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left"
                     Text="XIVLauncher is installed here, but Dalamud has not saved any settings yet. Restore a backup from your old PC to bring your plugin settings back, or start the game once with Dalamud and back up afterwards." />
        </StackPanel>
        <Border Grid.Column="1" Classes="glow" VerticalAlignment="Center" Margin="24,0,0,0">
          <c:XvButton Classes="primary lg" Icon="RotateCcw" Content="Restore Backup" Command="{Binding RestoreCommand}" />
        </Border>
      </Grid>
    </Border>

    <!-- Health card: XIVLauncher not found -->
    <Border Classes="card" Padding="20,22" BorderBrush="{StaticResource Border2}" IsVisible="{Binding ShowNotDetected}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="section-title" Text="XIVLauncher not found" />
          <TextBlock Classes="body t2" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left" Text="{Binding NotDetectedDescription}" />
        </StackPanel>
        <c:XvButton Grid.Column="1" Classes="secondary lg" Icon="Settings" Content="Open Settings" VerticalAlignment="Center"
                    Margin="24,0,0,0" Command="{Binding OpenSettingsCommand}" />
      </Grid>
    </Border>

    <!-- Loading -->
    <Border Classes="card" Padding="20,22" IsVisible="{Binding State, Converter={x:Static v:Converters.IsLoading}}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <c:Spinner Classes="spin" Width="14" Height="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
        <TextBlock Classes="body t2" Text="Looking for XIVLauncher and your backups…" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <c:Banner Tone="Critical" Title="The latest backup did not pass verification"
              Description="{Binding FailedDescription}" Meta="{Binding FailedMeta}" IsVisible="{Binding ShowFailed}" />
    <c:Banner Tone="Warning" Title="{Binding Subtitle}" IsVisible="{Binding ShowAttention}" />

    <!-- Status row -->
    <ItemsControl ItemsSource="{Binding StatusRow}" Margin="4,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel ItemSpacing="22" LineSpacing="6" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StatusItem">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <c:StatusDot Tone="{Binding Tone}" Diameter="5" VerticalAlignment="Center" />
            <TextBlock Classes="compact t2" Text="{Binding Label}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Flow diagram -->
    <Border Classes="panel" Padding="20,16">
      <Grid ColumnDefinitions="*,80,*,80,*">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border2}" BorderThickness="1">
            <c:Icon Kind="Monitor" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="body-strong" Text="XIVLauncher" />
            <TextBlock Classes="data t3" FontSize="11" Text="{Binding LauncherPath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LauncherPath}" />
          </StackPanel>
        </Grid>
        <c:FlowLine Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource AccentSubtle}" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1">
            <Border Classes="diamond" RenderTransform="rotate(45deg)" Width="10" Height="10" BorderBrush="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="body-strong" Text="XIVault" />
            <TextBlock Classes="data t3" FontSize="11" Text="snapshot · compress · verify" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <c:FlowLine Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Grid Grid.Column="4" ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border2}" BorderThickness="1">
            <c:Icon Kind="Cloud" Foreground="{StaticResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="body-strong" Text="Backup Storage" />
            <TextBlock Classes="data t3" FontSize="11" Text="{Binding Destination}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Destination}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Recent backups -->
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto" Margin="4,0">
        <TextBlock Classes="card-title" Text="Recent backups" VerticalAlignment="Bottom" />
        <Button Grid.Column="1" Theme="{StaticResource LinkButton}" Command="{Binding AllBackupsCommand}" AutomationProperties.Name="All backups">
          <TextBlock Classes="compact" Text="All backups ›" />
        </Button>
      </Grid>
      <Border Classes="card" IsVisible="{Binding !HasRecent}">
        <c:EmptyState Title="No backups recorded" Description="The first backup will appear here with its size and verification result." />
      </Border>
      <Border Classes="card" ClipToBounds="True" IsVisible="{Binding HasRecent}">
        <ItemsControl Classes="rows" ItemsSource="{Binding Recent}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BackupRowViewModel">
              <Border Classes="row enter" Height="36" Padding="14,0" AutomationProperties.Name="{Binding AccessibleName}">
                <Grid ColumnDefinitions="110,90,90,*,Auto" ColumnSpacing="12">
                  <TextBlock Classes="strong" Text="{Binding Day}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="data t2" Text="{Binding Time}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="data t2" Text="{Binding Size}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Classes="compact t3" Text="{Binding TypeLabel}" VerticalAlignment="Center" />
                  <c:StatusBadge Grid.Column="4" Classes="sm" Tone="{Binding IntegrityTone}" Label="{Binding IntegrityLabel}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </StackPanel>
  </Grid>
</UserControl>
