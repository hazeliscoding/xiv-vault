<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:XivVault.Desktop.Controls">

  <!-- Button: classes primary | secondary (default) | ghost | danger, sm | lg, icon. -->
  <ControlTheme x:Key="{x:Type c:XvButton}" TargetType="c:XvButton">
    <Setter Property="Background" Value="{StaticResource Bg3}" />
    <Setter Property="Foreground" Value="{StaticResource Text1}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <!-- A base transform is needed for the pressed-state nudge below to apply. -->
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Panel>
            <StackPanel Name="PART_Content" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <c:Icon Name="PART_Icon" Kind="{TemplateBinding Icon}" VerticalAlignment="Center"
                      IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalAlignment="Center"
                                IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <c:Icon Name="PART_IconRight" Kind="{TemplateBinding IconRight}" VerticalAlignment="Center"
                      IsVisible="{TemplateBinding IconRight, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <c:Spinner Name="PART_Spinner" Classes="spin" Width="12" Height="12" IsVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Text2}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{StaticResource Bg4}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border3}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="translateY(0.5px)" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Border">
      <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="Cursor" Value="No" />
    </Style>
    <Style Selector="^:loading">
      <Style Selector="^ /template/ StackPanel#PART_Content">
        <Setter Property="Opacity" Value="0" />
      </Style>
      <Style Selector="^ /template/ c|Spinner#PART_Spinner">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>

    <Style Selector="^.secondary /template/ Border#PART_Border">
      <Setter Property="BoxShadow" Value="{StaticResource HighlightInset}" />
    </Style>

    <Style Selector="^.primary">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource TextInverse}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{StaticResource AccentHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{StaticResource AccentActive}" />
      </Style>
    </Style>

    <Style Selector="^.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Text2}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text1}" />
        <Style Selector="^ /template/ Border#PART_Border">
          <Setter Property="Background" Value="{StaticResource Bg3}" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
      </Style>
    </Style>

    <Style Selector="^.danger">
      <Setter Property="Background" Value="{StaticResource CriticalSubtle}" />
      <Setter Property="Foreground" Value="{StaticResource CriticalText}" />
      <Setter Property="BorderBrush" Value="{StaticResource CriticalBorder}" />
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="White" />
        <Style Selector="^ /template/ Border#PART_Border">
          <Setter Property="Background" Value="{StaticResource Critical}" />
          <Setter Property="BorderBrush" Value="{StaticResource Critical}" />
        </Style>
      </Style>
    </Style>

    <Style Selector="^.sm">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="12" />
      <Style Selector="^ /template/ c|Icon">
        <Setter Property="Size" Value="12" />
      </Style>
    </Style>
    <Style Selector="^.lg">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="^.icon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^.icon.sm">
      <Setter Property="Width" Value="24" />
    </Style>
  </ControlTheme>

  <!-- Switch: 28x16 track, 10 px knob. -->
  <ControlTheme x:Key="{x:Type c:XvSwitch}" TargetType="c:XvSwitch">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Track" Width="28" Height="16" CornerRadius="8"
                Background="{StaticResource Bg4}" BorderBrush="{StaticResource Border3}" BorderThickness="1">
          <Ellipse Name="PART_Knob" Width="10" Height="10" Margin="2,0,0,0" RenderTransform="none"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{StaticResource Text2}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked">
      <Style Selector="^ /template/ Border#PART_Track">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      </Style>
      <Style Selector="^ /template/ Ellipse#PART_Knob">
        <Setter Property="RenderTransform" Value="translateX(12px)" />
        <Setter Property="Fill" Value="{StaticResource TextInverse}" />
      </Style>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Track">
      <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="Cursor" Value="No" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:StatusBadge}" TargetType="c:StatusBadge">
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding ToneSubtle}" BorderBrush="{TemplateBinding ToneBorder}"
                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <StackPanel Name="PART_Row" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <c:StatusDot Tone="{TemplateBinding Tone}" Diameter="5" VerticalAlignment="Center" />
            <TextBlock Name="PART_Label" Text="{TemplateBinding Label}" Foreground="{TemplateBinding ToneText}"
                       FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.sm">
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="FontSize" Value="10" />
      <Style Selector="^ /template/ StackPanel#PART_Row">
        <Setter Property="Spacing" Value="4" />
      </Style>
    </Style>
    <Style Selector="^.upper /template/ TextBlock#PART_Label">
      <Setter Property="LetterSpacing" Value="0.66" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:Banner}" TargetType="c:Banner">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding ToneSubtle}" BorderBrush="{TemplateBinding ToneBorder}"
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
          <Grid ColumnDefinitions="3,Auto,*,Auto">
            <Border Grid.Column="0" Background="{TemplateBinding ToneMain}" />
            <c:Icon Grid.Column="1" Kind="{TemplateBinding ResolvedIcon}" Foreground="{TemplateBinding ToneMain}"
                    Margin="9,11,10,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="2" Margin="0,8,10,8" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Title}" Foreground="{TemplateBinding TitleBrush}"
                         FontWeight="SemiBold" FontSize="13" LineHeight="19.5" TextWrapping="Wrap" />
              <TextBlock Text="{TemplateBinding Description}" Classes="compact t2" TextWrapping="Wrap"
                         IsVisible="{TemplateBinding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{TemplateBinding Meta}" Classes="data t3" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                         IsVisible="{TemplateBinding Meta, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <ContentPresenter Grid.Column="3" Content="{TemplateBinding Actions}" Margin="0,8,10,8" VerticalAlignment="Top" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:EmptyState}" TargetType="c:EmptyState">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="24" Height="24" CornerRadius="6" Background="{TemplateBinding ToneSubtle}"
                    BorderBrush="{TemplateBinding ToneBorder}" BorderThickness="1" VerticalAlignment="Center">
              <c:Icon Kind="{TemplateBinding Icon}" Size="13" Foreground="{TemplateBinding ToneMain}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{TemplateBinding Title}" Classes="body-strong t1" />
              <TextBlock Text="{TemplateBinding Description}" Classes="compact t2" TextWrapping="Wrap"
                         IsVisible="{TemplateBinding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Left navigation entry. -->
  <ControlTheme x:Key="NavItem" TargetType="Button">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" HorizontalAlignment="Left" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{StaticResource Bg3}" />
      <Setter Property="Foreground" Value="{StaticResource Text1}" />
    </Style>
    <Style Selector="^.active">
      <Setter Property="Background" Value="{StaticResource Bg3}" />
      <Setter Property="Foreground" Value="{StaticResource Text1}" />
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="inset 2 0 0 0 #6C9EFF" />
      </Style>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Border">
      <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
    </Style>
  </ControlTheme>

  <!-- A plain text link such as "All backups ›". -->
  <ControlTheme x:Key="LinkButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" Background="Transparent" CornerRadius="2">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Border">
      <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
    </Style>
  </ControlTheme>

  <!-- The "?" that explains a technical term in one sentence. -->
  <ControlTheme x:Key="ExplainButton" TargetType="Button">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Text3}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border3}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Help" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" CornerRadius="7" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
          <TextBlock Text="?" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{TemplateBinding Foreground}" Margin="0,-1,0,0" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover, ^:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource AccentText}" />
      <Setter Property="Background" Value="{StaticResource AccentSubtle}" />
    </Style>
  </ControlTheme>

  <!-- Segmented control built on ListBox, so it keeps arrow-key selection and screen-reader roles. -->
  <ControlTheme x:Key="SegmentedItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" CornerRadius="3" Padding="{TemplateBinding Padding}" Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Text1}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{StaticResource Text1}" />
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="{StaticResource Bg3}" />
        <Setter Property="BoxShadow" Value="0 1 2 0 #59000000, inset 0 1 0 0 #0AFFFFFF" />
      </Style>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Border">
      <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Segmented" TargetType="ListBox">
    <Setter Property="Height" Value="28" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource SegmentedItem}" />
    <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="1" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{StaticResource BgInset}" BorderBrush="{StaticResource Border2}" BorderThickness="1"
                CornerRadius="4" Padding="2">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.sm">
      <Setter Property="Height" Value="24" />
    </Style>
  </ControlTheme>

  <!-- Selectable backup row in the restore wizard. -->
  <ControlTheme x:Key="ChoiceItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" Height="44" CornerRadius="6" Padding="14,0" BorderThickness="1"
                Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border1}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" HorizontalContentAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{StaticResource Bg3}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Border">
      <Setter Property="Background" Value="{StaticResource AccentSubtle}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}" />
      <Setter Property="BoxShadow" Value="{StaticResource AccentGlow}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Border">
      <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
    </Style>
  </ControlTheme>

  <!-- Weekday picker on the Schedule screen. -->
  <ControlTheme x:Key="DayToggle" TargetType="Button">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Background" Value="{StaticResource Bg3}" />
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border2}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="4">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource Border3}" />
    </Style>
    <Style Selector="^.on">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="{StaticResource TextInverse}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Border">
      <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="No" />
    </Style>
  </ControlTheme>

  <!-- Window caption buttons. -->
  <ControlTheme x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Foreground" Value="{StaticResource Text3}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="3">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{StaticResource Bg3}" />
      <Setter Property="Foreground" Value="{StaticResource Text1}" />
    </Style>
    <Style Selector="^.close:pointerover">
      <Setter Property="Background" Value="{StaticResource Critical}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
