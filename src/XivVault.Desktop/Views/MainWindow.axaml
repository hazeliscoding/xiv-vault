<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:XivVault.Desktop.Controls"
        xmlns:vm="using:XivVault.Desktop.ViewModels"
        xmlns:s="using:XivVault.Desktop.Services"
        x:Class="XivVault.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="XIV Vault"
        Icon="avares://XivVault/Assets/xiv-vault.ico"
        Width="1100" Height="720" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">
  <Panel>
    <Grid RowDefinitions="34,*">
      <!-- Title bar -->
      <Border Grid.Row="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1"
              WindowDecorationProperties.ElementRole="TitleBar">
        <Grid ColumnDefinitions="*,Auto" Margin="14,0,6,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="diamond" RenderTransform="rotate(45deg)" Width="10" Height="10" BorderBrush="{StaticResource Accent}"
                    BoxShadow="0 0 8 0 #736C9EFF" />
            <TextBlock Text="XIV Vault" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Text2}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Theme="{StaticResource CaptionButton}" Content="—" Click="OnMinimize"
                    WindowDecorationProperties.ElementRole="MinimizeButton" AutomationProperties.Name="Minimize" />
            <Button Theme="{StaticResource CaptionButton}" Content="▢" Click="OnMaximize"
                    WindowDecorationProperties.ElementRole="MaximizeButton" AutomationProperties.Name="Maximize" />
            <Button Theme="{StaticResource CaptionButton}" Classes="close" Content="✕" Click="OnClose"
                    WindowDecorationProperties.ElementRole="CloseButton" AutomationProperties.Name="Close" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="196,*">
        <!-- Navigation -->
        <Border Grid.Column="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,1,0"
                Padding="8,12,8,10">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="0">
              <Border Margin="2,0,2,10" Padding="10" CornerRadius="6" Background="{StaticResource Bg2}"
                      BorderBrush="{StaticResource Border1}" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Classes="micro t3" Text="WHAT IS PROTECTED" />
                  <TextBlock Classes="compact t2" TextWrapping="Wrap"
                             Text="XIV Vault protects portable Dalamud configuration. Plugin binaries are reinstalled by Dalamud rather than copied between machines." />
                </StackPanel>
              </Border>
              <Button Theme="{StaticResource LinkButton}" Foreground="{StaticResource AccentText}" Margin="10,0,4,8"
                      Command="{Binding OpenUpdatesCommand}" IsVisible="{Binding Updates.HasUpdate}"
                      AutomationProperties.Name="{Binding Updates.NavLabel}" ToolTip.Tip="Open Settings to install it">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:StatusDot Tone="Accent" Diameter="5" VerticalAlignment="Center" />
                  <TextBlock Classes="compact" Text="{Binding Updates.NavLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="10,0,4,0">
                <TextBlock Classes="data t3" FontSize="11" Text="{Binding VersionLabel}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource LinkButton}" Foreground="{StaticResource Text3}"
                        Command="{Binding OpenGitHubCommand}" AutomationProperties.Name="Open XIV Vault on GitHub">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <c:Icon Kind="Github" Size="12" VerticalAlignment="Center" />
                    <TextBlock Classes="data" FontSize="11" Text="GitHub" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,6,10,0">
                <c:StatusDot Tone="{Binding ConnectionTone}" Diameter="5" VerticalAlignment="Center" />
                <TextBlock Classes="compact t3" Text="{Binding ConnectionLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding NavItems}" DockPanel.Dock="Top">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItemViewModel">
                  <Button Theme="{StaticResource NavItem}" Classes.active="{Binding IsActive}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                          CommandParameter="{Binding Page}"
                          AutomationProperties.Name="{Binding Label}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <c:Icon Kind="{Binding Icon}" Size="14" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Panel />
          </DockPanel>
        </Border>

        <!-- Page -->
        <Panel Grid.Column="1" ClipToBounds="True">
          <Border IsHitTestVisible="False">
            <Border.Background>
              <RadialGradientBrush Center="85%,-8%" GradientOrigin="85%,-8%" RadiusX="62%" RadiusY="41%">
                <GradientStop Offset="0" Color="#12B48EFF" />
                <GradientStop Offset="0.65" Color="#00B48EFF" />
              </RadialGradientBrush>
            </Border.Background>
          </Border>
          <Border IsHitTestVisible="False">
            <Border.Background>
              <RadialGradientBrush Center="5%,108%" GradientOrigin="5%,108%" RadiusX="53%" RadiusY="35%">
                <GradientStop Offset="0" Color="#0F6C9EFF" />
                <GradientStop Offset="0.65" Color="#006C9EFF" />
              </RadialGradientBrush>
            </Border.Background>
          </Border>
          <ScrollViewer Name="PageScroller" HorizontalScrollBarVisibility="Disabled">
            <TransitioningContentControl Content="{Binding CurrentPage}" Margin="24,22,24,24">
              <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.12" />
              </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
          </ScrollViewer>
        </Panel>
      </Grid>
    </Grid>

    <!-- Confirmation modal -->
    <Panel IsVisible="{Binding Dialogs.Active, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Background="{StaticResource Scrim}" PointerPressed="OnScrimPressed" />
      <ContentControl Content="{Binding Dialogs.Active}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="s:ConfirmDialog">
            <Border Width="420" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border2}" BorderThickness="1"
                    CornerRadius="8" BoxShadow="{StaticResource Shadow4}">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="16,12,12,12">
                  <TextBlock Classes="section-title" Text="{Binding Request.Title}" VerticalAlignment="Center" />
                  <c:XvButton Grid.Column="1" Classes="ghost icon" Icon="X" Command="{Binding CancelCommand}"
                              AutomationProperties.Name="Close" ToolTip.Tip="Close" />
                </Grid>
                <Border Classes="divider" />
                <StackPanel Margin="16" Spacing="10">
                  <TextBlock Classes="body t1" Text="{Binding Request.Detail}" TextWrapping="Wrap"
                             IsVisible="{Binding Request.Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Classes="body t2" Text="{Binding Request.Message}" TextWrapping="Wrap" />
                  <TextBlock Classes="data t3" FontSize="11.5" Text="{Binding Request.Note}" TextWrapping="Wrap"
                             IsVisible="{Binding Request.Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <Border Classes="divider" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="16,12">
                  <c:XvButton Classes="ghost" Content="{Binding Request.CancelText}" Command="{Binding CancelCommand}" IsCancel="True" />
                  <c:XvButton Classes.danger="{Binding Request.Danger}" Classes.primary="{Binding !Request.Danger}"
                              Icon="{Binding Request.ConfirmIcon}" Content="{Binding Request.ConfirmText}"
                              Command="{Binding ConfirmCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Panel>
  </Panel>
</Window>
