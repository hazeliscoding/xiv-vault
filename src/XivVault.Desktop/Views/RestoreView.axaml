<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:XivVault.Desktop.Controls"
             xmlns:vm="using:XivVault.Desktop.ViewModels"
             xmlns:v="using:XivVault.Desktop.Views"
             x:Class="XivVault.Desktop.Views.RestoreView"
             x:DataType="vm:RestoreViewModel">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MaxWidth="820" />
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Classes="page-title" Text="Restore" />
        <TextBlock Classes="body t2" Text="Bring back Dalamud and game settings. Nothing changes until the last step." />
      </StackPanel>

      <!-- Steps -->
      <ItemsControl ItemsSource="{Binding Steps}" AutomationProperties.Name="Restore steps">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StepItem">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Panel Width="20" Height="20" VerticalAlignment="Center">
                <Border CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Border2}" IsVisible="{Binding State, Converter={x:Static v:Converters.IsTodo}}">
                  <TextBlock Classes="data t3" FontSize="11" Text="{Binding Mark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="10" Background="{StaticResource Accent}" IsVisible="{Binding State, Converter={x:Static v:Converters.IsCurrent}}">
                  <TextBlock Classes="data" FontSize="11" Foreground="{StaticResource TextInverse}" Text="{Binding Mark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="10" BorderThickness="1" Background="{StaticResource AccentSubtle}" BorderBrush="{StaticResource AccentBorder}"
                        IsVisible="{Binding State, Converter={x:Static v:Converters.IsDone}}">
                  <c:Icon Kind="Check" Size="11" StrokeWidth="2.5" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Panel>
              <TextBlock Classes="compact" FontWeight="Medium" Text="{Binding Label}" VerticalAlignment="Center"
                         Classes.t1="{Binding State, Converter={x:Static v:Converters.IsCurrent}}"
                         Classes.accent="{Binding State, Converter={x:Static v:Converters.IsDone}}"
                         Classes.t3="{Binding State, Converter={x:Static v:Converters.IsTodo}}" />
              <Border Width="36" Height="1" Background="{StaticResource Border2}" VerticalAlignment="Center" IsVisible="{Binding HasLine}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <c:Banner Tone="Critical" Title="Restore can't continue" Description="{Binding ErrorMessage}"
                IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- Step 1: choose -->
      <StackPanel Spacing="16" IsVisible="{Binding IsStep1}">
        <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" Background="Transparent"
                 ItemContainerTheme="{StaticResource ChoiceItem}" IsVisible="{Binding HasChoices}" IsEnabled="{Binding !IsLoading}"
                 AutomationProperties.Name="Backups you can restore">
          <ListBox.Template>
            <ControlTemplate>
              <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BackupRowViewModel">
              <Grid ColumnDefinitions="18,150,*,170,Auto" ColumnSpacing="14" AutomationProperties.Name="{Binding AccessibleName}">
                <Panel Width="14" Height="14" VerticalAlignment="Center">
                  <Ellipse Classes="radio" StrokeThickness="1.5" />
                  <Ellipse Classes="radio-dot" Width="6" Height="6" />
                </Panel>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Classes="strong">
                    <Run Text="{Binding Day}" /><Run Text=" · " /><Run Text="{Binding Time}" />
                  </TextBlock>
                  <TextBlock Classes="compact t3" Text="{Binding Age}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="compact t2" Text="{Binding PluginSummary}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Border Classes="type-mark" RenderTransform="rotate(45deg)" Background="{Binding TypeTone, Converter={x:Static c:ToneConverters.Main}}" />
                  <TextBlock Classes="compact t3" Text="{Binding TypeLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <c:StatusBadge Grid.Column="4" Classes="sm" Tone="{Binding IntegrityTone}" Label="{Binding IntegrityLabel}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <c:Banner Tone="Info" Icon="Cloud" Title="This backup is in the cloud" Description="{Binding CloudNoteText}"
                  IsVisible="{Binding ShowCloudNote}" />
        <c:Banner Tone="Info" Icon="Cloud" Title="Downloading the backup" Description="{Binding DownloadText}"
                  IsVisible="{Binding IsDownloading}">
          <c:Banner.Actions>
            <c:XvButton Classes="ghost sm" Content="Cancel" Command="{Binding CancelDownloadCommand}" />
          </c:Banner.Actions>
        </c:Banner>

        <Panel IsVisible="{Binding !HasChoices}">
          <Rectangle Classes="dashed-card" />
          <StackPanel Margin="20,22" Spacing="6">
            <TextBlock Classes="section-title" Text="No backups found" />
            <TextBlock Classes="body t2" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left">
              <Run Text="XIV Vault looked in " /><Run Text="{Binding Destination}" /><Run Text=". On a new PC, wait for OneDrive or Dropbox to finish syncing, choose the folder that holds your backups in Settings, or pick a backup file directly." />
            </TextBlock>
          </StackPanel>
        </Panel>

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <c:XvButton Classes="ghost" Icon="FolderOpen" Content="Choose a backup file…" Command="{Binding ChooseFileCommand}"
                        IsEnabled="{Binding !IsLoading}" />
            <c:XvButton Classes="ghost" Icon="Settings" Content="Change backup folder" Command="{Binding OpenSettingsCommand}"
                        IsVisible="{Binding !HasChoices}" />
          </StackPanel>
          <c:XvButton Grid.Column="1" Classes="primary" IconRight="ChevronRight" Content="{Binding ContinueLabel}"
                      Command="{Binding ContinueCommand}" IsLoading="{Binding IsLoading}" c:FocusFallback.IsTarget="True" />
        </Grid>
      </StackPanel>

      <!-- Step 2: review -->
      <StackPanel Spacing="16" IsVisible="{Binding IsStep2}">
        <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="{Binding SelectedTitle}" />
          <c:Banner Tone="Warning" Title="Settings saved since this backup will be replaced" Description="{Binding OlderWarningText}"
                    IsVisible="{Binding ShowOlderWarning}" />
          <c:Banner Tone="Critical" Title="XIVLauncher isn't set up on this PC yet" Description="{Binding TargetProblem}"
                    IsVisible="{Binding TargetProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
            <c:Banner.Actions>
              <c:XvButton Classes="ghost sm" Content="Open Settings" Command="{Binding OpenSettingsCommand}" />
            </c:Banner.Actions>
          </c:Banner>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Classes="card" BorderBrush="{StaticResource AccentBorder}" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Classes="micro accent" Text="IN THIS BACKUP" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Panel Width="14">
                      <c:Icon Kind="Check" Size="13" StrokeWidth="2.2" Foreground="{StaticResource Healthy}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding AnyPluginChosen}" />
                      <TextBlock FontFamily="{StaticResource MonoFont}" Text="–" Classes="t3" HorizontalAlignment="Center" IsVisible="{Binding !AnyPluginChosen}" />
                    </Panel>
                    <TextBlock Classes="body" Text="{Binding PluginsLabel}" Classes.t1="{Binding AnyPluginChosen}" Classes.t3="{Binding !AnyPluginChosen}" />
                  </StackPanel>
                  <c:XvButton Grid.Column="1" Classes="ghost sm" Content="{Binding PluginListButtonLabel}" Command="{Binding TogglePluginListCommand}"
                              AutomationProperties.Name="{Binding PluginListButtonName}" Margin="0,-4" />
                </Grid>
                <Border IsVisible="{Binding IsPluginListOpen}" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border1}"
                        BorderThickness="1" CornerRadius="6" Padding="8">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                      <TextBox Text="{Binding PluginFilter}" PlaceholderText="Filter plugins" AutomationProperties.Name="Filter plugins">
                        <TextBox.InnerLeftContent>
                          <c:Icon Kind="Filter" Size="13" Foreground="{StaticResource Text3}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </TextBox.InnerLeftContent>
                      </TextBox>
                      <Button Grid.Column="1" Theme="{StaticResource LinkButton}" Command="{Binding ChooseAllPluginsCommand}" VerticalAlignment="Center"
                              AutomationProperties.Name="Choose every plugin">
                        <TextBlock Classes="compact" Text="Select all" />
                      </Button>
                      <Button Grid.Column="2" Theme="{StaticResource LinkButton}" Command="{Binding ChooseNoPluginsCommand}" VerticalAlignment="Center"
                              AutomationProperties.Name="Choose no plugins">
                        <TextBlock Classes="compact" Text="Select none" />
                      </Button>
                    </Grid>
                    <ScrollViewer MaxHeight="196">
                      <ItemsControl ItemsSource="{Binding VisiblePluginChoices}" AutomationProperties.Name="Plugins to restore">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PluginChoice">
                            <CheckBox Theme="{StaticResource ChoiceToggle}" Content="{Binding Name}" IsChecked="{Binding IsChosen}"
                                      AutomationProperties.Name="{Binding Name}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Classes="compact t3" Text="No plugins match." Margin="4,0" IsVisible="{Binding NoPluginMatches}" />
                  </StackPanel>
                </Border>
                <CheckBox Theme="{StaticResource ChoiceToggle}" Content="Dalamud settings" IsChecked="{Binding DalamudSettingsChosen}"
                          IsEnabled="{Binding HasDalamudSettings}" Margin="-4,-3" />
                <ItemsControl ItemsSource="{Binding DalamudDetails}" Margin="22,0,0,0" AutomationProperties.Name="Dalamud settings">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContentItem">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel Width="14">
                          <c:Icon Kind="Check" Size="13" StrokeWidth="2.2" Foreground="{StaticResource Healthy}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Included}" />
                          <TextBlock FontFamily="{StaticResource MonoFont}" Text="–" Classes="t3" HorizontalAlignment="Center" IsVisible="{Binding !Included}" />
                        </Panel>
                        <TextBlock Classes="body" Text="{Binding Label}" Classes.t1="{Binding Included}" Classes.t3="{Binding !Included}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Theme="{StaticResource ChoiceToggle}" Content="{Binding CharacterSettingsLabel}" IsChecked="{Binding CharacterSettingsChosen}"
                          IsEnabled="{Binding HasCharacterSettings}" Margin="-4,-3" AutomationProperties.Name="Character settings" />
                <TextBlock Classes="compact t3" Margin="22,-6,0,0" TextWrapping="Wrap" IsVisible="{Binding HasCharacterSettings}"
                           Text="HUD layout, hotbars, keybinds, macros and gear sets" />
                <CheckBox Theme="{StaticResource ChoiceToggle}" Content="{Binding SystemSettingsLabel}" IsChecked="{Binding SystemSettingsChosen}"
                          IsEnabled="{Binding HasSystemSettings}" Margin="-4,-3" AutomationProperties.Name="System settings" />
                <TextBlock Classes="compact t3" Margin="22,-6,0,0" TextWrapping="Wrap" IsVisible="{Binding HasSystemSettings}"
                           Text="Graphics, sound and display, including the resolution and monitor" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Classes="micro t3" Text="ON THIS PC RIGHT NOW" />
                <ItemsControl ItemsSource="{Binding Current}" AutomationProperties.Name="On this PC right now">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CurrentItem">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="body t2" Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Classes="data t3" FontSize="11" Text="{Binding Meta}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
          <Border Classes="card" Padding="16,14" IsVisible="{Binding ShowPluginInstalls}">
            <StackPanel Spacing="10">
              <CheckBox Theme="{StaticResource ChoiceToggle}" Content="Install missing plugins" IsChecked="{Binding InstallMissingPlugins}"
                        IsEnabled="{Binding CanInstallPlugins}" />
              <TextBlock Classes="compact t3" TextWrapping="Wrap" Text="Beta feature. Requires Dalamud settings to be restored. Existing plugins stay as they are. The backup's list may include plugins you removed in game." />
              <StackPanel Spacing="10" IsVisible="{Binding WillInstallPlugins}">
                <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding MissingPluginsText}" />
                <TextBlock Classes="compact t3" TextWrapping="Wrap" Text="XIV Vault looks in Dalamud's official repository and the custom repositories you choose below. It downloads current versions when available. Nothing executable comes from the backup." />
                <StackPanel Spacing="8" IsVisible="{Binding ShowRepositoryChoices}">
                  <TextBlock Classes="strong" Text="Custom repositories" />
                  <TextBlock Classes="compact t3" TextWrapping="Wrap" Text="Dalamud warns: Plugins have full control over your PC, like any other program, and may cause harm or crashes. Please make absolutely sure that you only install plugins from developers you trust." />
                  <ItemsControl ItemsSource="{Binding RepositoryChoices}" AutomationProperties.Name="Custom repositories to install from">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RepositoryChoice">
                        <CheckBox Theme="{StaticResource ChoiceToggle}" Content="{Binding Label}" IsChecked="{Binding IsChosen}" AutomationProperties.Name="{Binding Label}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <TextBlock Classes="compact t3" TextWrapping="Wrap" Text="Repository hosts see which plugins are requested. XIV Vault sends no configuration contents, character information or backups." />
                <c:Banner Tone="Warning" Title="Dalamud hasn't finished downloading" IsVisible="{Binding ShowDalamudNotReady}"
                          Description="Open XIVLauncher, let it finish, close it and restore again. Settings can still be restored now; plugins will wait." />
              </StackPanel>
            </StackPanel>
          </Border>
          <c:Banner Tone="Info" Icon="ShieldCheck" Title="XIV Vault will create a safety backup of your current configuration before restoring anything."
                    Description="It appears in Backups as a Pre-Restore Safety Backup and can be restored the same way." />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <c:XvButton Classes="ghost" Icon="ChevronLeft" Content="Back" Command="{Binding BackCommand}" />
          <TextBlock Grid.Column="1" Classes="compact t3" Text="{Binding ChoiceProblem}" VerticalAlignment="Center"
                     IsVisible="{Binding ChoiceProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <c:XvButton Grid.Column="2" Classes="primary" IconRight="ChevronRight" Content="Continue"
                      Command="{Binding ContinueCommand}" IsLoading="{Binding IsLoading}" c:FocusFallback.IsTarget="True" />
        </Grid>
      </StackPanel>

      <!-- Step 3: safety checks and the restore itself -->
      <StackPanel Spacing="16" IsVisible="{Binding IsStep3}">
        <Border Classes="card" ClipToBounds="True" MinHeight="40">
          <Panel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,12" IsVisible="{Binding IsLoading}">
              <c:Spinner Classes="spin" Width="12" Height="12" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
              <TextBlock Classes="body t2" Text="Running safety checks…" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl Classes="rows" ItemsSource="{Binding Checks}" AutomationProperties.Name="Safety checks">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CheckItem">
                  <Border Classes="row enter" Height="40" Padding="16,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                      <c:StatusDot Tone="{Binding Tone}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="body" Text="{Binding Label}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="data t3" FontSize="11.5" Text="{Binding Detail}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="360" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </Border>

        <Border Classes="card" Padding="16,14" BorderBrush="{StaticResource AccentBorder}" BoxShadow="{StaticResource AccentGlow}"
                IsVisible="{Binding IsRestoring}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
            <c:AetherRing Size="40" VerticalAlignment="Center" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Stages}" VerticalAlignment="Center" AutomationProperties.Name="Restore stages">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StageItem">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:Icon Kind="Check" Size="12" StrokeWidth="2.2" Width="14" Foreground="{StaticResource HealthyText}" VerticalAlignment="Center"
                            IsVisible="{Binding State, Converter={x:Static v:Converters.IsDone}}" />
                    <TextBlock Width="14" TextAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding Mark}"
                               IsVisible="{Binding State, Converter={x:Static v:Converters.IsNotDone}}"
                               Classes.t1="{Binding State, Converter={x:Static v:Converters.IsCurrent}}"
                               Classes.t3="{Binding State, Converter={x:Static v:Converters.IsTodo}}" />
                    <TextBlock Classes="compact" Text="{Binding Label}"
                               Classes.healthy="{Binding State, Converter={x:Static v:Converters.IsDone}}"
                               Classes.t1="{Binding State, Converter={x:Static v:Converters.IsCurrent}}"
                               Classes.t3="{Binding State, Converter={x:Static v:Converters.IsTodo}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <c:XvButton Classes="ghost" Icon="ChevronLeft" Content="Back" Command="{Binding BackCommand}" />
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Classes="compact t3" Text="{Binding RestoreSummary}" VerticalAlignment="Center" TextAlignment="Right"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RestoreSummary}" />
            <c:XvButton Grid.Column="1" Classes="ghost" Icon="RefreshCw" Content="Run checks again" Command="{Binding RunChecksCommand}"
                        IsVisible="{Binding !ChecksPassed}" />
          </Grid>
          <Border Grid.Column="2" Classes="glow">
            <c:XvButton Classes="primary" Icon="RotateCcw" Content="Restore Configuration"
                        Command="{Binding RestoreNowCommand}" IsEnabled="{Binding CanRestore}" IsLoading="{Binding IsRestoring}" c:FocusFallback.IsTarget="True" />
          </Border>
        </Grid>
      </StackPanel>

      <!-- Step 4: complete -->
      <StackPanel Spacing="16" IsVisible="{Binding IsStep4}">
        <Border Classes="card complete-pulse" Padding="20,36,20,28">
          <StackPanel Spacing="18" HorizontalAlignment="Center">
            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource HealthySubtle}" BorderBrush="{StaticResource HealthyBorder}"
                    BorderThickness="1" HorizontalAlignment="Center">
              <c:Icon Kind="Check" Size="20" Foreground="{StaticResource Healthy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <TextBlock Classes="page-title" Text="Restore complete" HorizontalAlignment="Center" />
              <TextBlock Classes="body t2" Text="{Binding SelectedTitle}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:StatusDot Tone="Healthy" VerticalAlignment="Center" />
                <TextBlock Classes="body" Text="{Binding ResultPlugins}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:StatusDot Tone="Healthy" VerticalAlignment="Center" />
                <TextBlock Classes="body" Text="{Binding ResultDalamud}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:StatusDot Tone="Healthy" VerticalAlignment="Center" />
                <TextBlock Classes="body" Text="{Binding ResultGame}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <c:StatusDot Tone="Healthy" VerticalAlignment="Center" />
                <TextBlock Classes="body" Text="{Binding ResultSnapshot}" ToolTip.Tip="{Binding ResultSnapshotFile}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
              <c:XvButton Classes="primary" Icon="ExternalLink" Content="Open XIVLauncher" Command="{Binding OpenLauncherCommand}"
                          IsVisible="{Binding CanOpenLauncher}" c:FocusFallback.IsTarget="True" />
              <c:XvButton Classes="secondary" Icon="Archive" Content="View Backups" Command="{Binding ViewBackupsCommand}" c:FocusFallback.IsTarget="True" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="16,14" IsVisible="{Binding HasPluginInstallReport}">
          <StackPanel Spacing="10">
            <TextBlock Classes="strong" Text="Plugins" />
            <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding InstalledPluginsText}" />
            <TextBlock Classes="compact t3" TextWrapping="Wrap" Text="{Binding AlreadyInstalledText}" />
            <c:Banner Tone="Warning" Title="Plugins are waiting for Dalamud" IsVisible="{Binding ResultNeedsDalamud}"
                      Description="Open XIVLauncher, let Dalamud finish downloading, close it and restore again." />
            <StackPanel Spacing="8" IsVisible="{Binding HasUninstalledPlugins}">
              <TextBlock Classes="body" TextWrapping="Wrap" Text="These plugins were not installed. Open the game's plugin installer (/xlplugins) to install them:" />
              <ItemsControl ItemsSource="{Binding UninstalledPlugins}" AutomationProperties.Name="Plugins not installed">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="compact t2" TextWrapping="Wrap" Text="{Binding}" Margin="0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Classes="compact t3" TextWrapping="Wrap" Text="Restoring the safety backup brings back your previous settings. Plugins installed during this restore stay installed." />
          </StackPanel>
        </Border>
        <c:XvButton Classes="ghost" Content="Start another restore" HorizontalAlignment="Right" Command="{Binding StartOverCommand}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
